{
  "expo": {
    "name": "CafeIndoor",
    "slug": "cafeinttarine",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "extra": {
      "eas": {
        "projectId": "8e511abd-9a4d-4d67-b996-d99040efa5fd"
      }
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D0D0D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.manikanthtarine.cafeindoor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.manikanthtarine.cafeindoor",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9922A",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "newArchEnabled": true,
    "owner": "tarinemanikanths-organization"
  }
}
